# S3-compatible storage configuration for DigitalOcean Spaces
# Add these variables to your .env file

# DigitalOcean Spaces configuration
S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
S3_ACCESS_KEY_ID=your_spaces_access_key
S3_SECRET_ACCESS_KEY=your_spaces_secret_key
S3_BUCKET_NAME=your-bucket-name
S3_REGION=nyc3

# Optional: Different regions available
# S3_ENDPOINT_URL=https://fra1.digitaloceanspaces.com  # Frankfurt
# S3_ENDPOINT_URL=https://sgp1.digitaloceanspaces.com  # Singapore
# S3_ENDPOINT_URL=https://sfo3.digitaloceanspaces.com  # San Francisco