# ============================================================================
# Odoo Docker Swarm Deployment - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in all values for your environment
# DO NOT commit .env file to version control (add to .gitignore)
# For production, generate strong, unique values for all secrets
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION (Required)
# ============================================================================
# RDS/PostgreSQL Host - use fully qualified domain name
DB_HOST=odoo16-postgres.cps6cceya1jb.eu-west-1.rds.amazonaws.com

# PostgreSQL Port (default: 5432)
DB_PORT=5432

# Database username (should match RDS setup)
DB_USER=odoo

# Database password - GENERATE A STRONG PASSWORD
# Example: $(openssl rand -hex 32)
# ⚠️  CRITICAL: Use strong password in production
DB_PASSWORD=your_strong_postgres_password_here

# Database name
DB_NAME=odoo

# ============================================================================
# ODOO CRON WORKER MODE (Optional - default: 0)
# ============================================================================
# Use this to designate which instance handles scheduled jobs
# Set to 2 on the designated cron worker replica
# Set to 0 on all other replicas (recommended to prevent duplicate cron execution)
# 
# Example setup for 2 replicas:
#   Replica 1 (cron worker): ODOO_CRON_MODE=2
#   Replica 2 (regular):     ODOO_CRON_MODE=0
#
ODOO_CRON_MODE=0

# ============================================================================
# S3 STORAGE CONFIGURATION (Optional but Recommended for Multi-Replica)
# ============================================================================
# For multi-replica deployments, using S3 ensures all replicas can access
# the same attachment files (PDF invoices, uploads, etc.)
# If not configured, attachments are stored locally in the volume
# (which may cause inconsistencies across replicas)

# S3 Endpoint URL (e.g., AWS S3, MinIO, DigitalOcean Spaces)
# For AWS S3: https://s3.amazonaws.com or https://s3.region.amazonaws.com
# For DigitalOcean Spaces: https://region.digitaloceanspaces.com
# For MinIO: http://minio:9000 or https://minio.example.com
S3_ENDPOINT=https://s3.amazonaws.com

# S3 Bucket Name - dedicated bucket for Odoo attachments
S3_BUCKET=my-odoo-attachments-bucket

# S3 Access Key ID
S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE

# S3 Secret Access Key
S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# S3 Session Token (optional, for temporary credentials)
S3_SESSION_TOKEN=

# ============================================================================
# ODOO AUTHENTICATION & SECURITY (Required)
# ============================================================================
# Secret key for session encryption and security
# Generate with: openssl rand -hex 64
# ⚠️  CRITICAL: Must be unique and secure in production
SECRET_KEY_BASE=your_64_character_hex_secret_key_here

# ============================================================================
# LOGGING CONFIGURATION (Optional - default: info)
# ============================================================================
# Log level: debug, info, warning, error, critical
# Use 'info' for production, 'debug' for troubleshooting
LOG_LEVEL=info

# ============================================================================
# DOMAIN & URL CONFIGURATION (Optional - for PWA/offline app)
# ============================================================================
# Used by Traefik routing and CORS configuration
# Update these to match your actual production domain

# Main Odoo domain
ODOO_DOMAIN=staging.linha1458.moz.wfp.org

# Offline PWA domain (if applicable)
PWA_DOMAIN=offline.linha1458.moz.wfp.org

# ============================================================================
# DOCKER SWARM SPECIFIC (Reference only, not used by Odoo directly)
# ============================================================================
# These values are referenced in docker-compose.yml labels
# Update them if you're using different domains or infrastructure

# Traefik entrypoint (web or websecure)
TRAEFIK_ENTRYPOINT=web

# ============================================================================
# AWS CREDENTIALS (Optional - if using AWS S3)
# ============================================================================
# Only needed if using S3 for attachments
# For ECS/EC2 with IAM roles, these are optional (use instance role)
# For other environments, fill these in

# AWS Region (e.g., eu-west-1, us-east-1)
AWS_REGION=eu-west-1

# AWS Access Key (if not using IAM role)
# AWS_ACCESS_KEY_ID=

# AWS Secret Key (if not using IAM role)
# AWS_SECRET_ACCESS_KEY=

# ============================================================================
# DIGITALOCEAN SPACES (Alternative - if using instead of AWS S3)
# ============================================================================
# Uncomment if using DigitalOcean Spaces for storage instead of AWS

# DO_SPACES_ENDPOINT=fra1.digitaloceanspaces.com
# DO_SPACES_NAME=odoo-attachments
# DO_SPACES_ACCESS_KEY=YOURKEY
# DO_SPACES_SECRET_KEY=YOURSECRET

# ============================================================================
# BACKUP & MAINTENANCE (Optional)
# ============================================================================
# Enable automatic backups (if using external service)
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
# BACKUP_RETENTION_DAYS=30

# ============================================================================
# HEALTH CHECK (Reference - automatically configured)
# ============================================================================
# Traefik will monitor the /web/health endpoint
# Replicas returning failures will be temporarily removed from rotation

# ============================================================================
# SECURITY NOTES FOR PRODUCTION
# ============================================================================
# 1. Generate strong passwords:
#    For PostgreSQL: openssl rand -hex 32
#    For SECRET_KEY_BASE: openssl rand -hex 64
#
# 2. Store this .env file securely:
#    - Use Docker Secrets in Swarm mode (recommended)
#    - Restrict file permissions: chmod 600 .env
#    - Never commit to version control
#    - Use .gitignore to exclude .env files
#
# 3. For AWS S3:
#    - Use IAM roles instead of access keys when possible
#    - If using keys, create a dedicated IAM user with S3-only permissions
#    - Rotate keys regularly
#
# 4. Monitor secrets rotation:
#    - Database passwords
#    - S3 access keys
#    - SESSION_KEY_BASE
# ============================================================================
