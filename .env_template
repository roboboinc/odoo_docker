# Database (Odoo production)
HOST=DATABASE_HOST
USER=DATABASE_USER
PASSWORD=DATABASE_PASSWORD

# Odoo API - FastAPI → Odoo Discuss (odoo.robobo.org uses ODOO_DB=robobo)
ODOO_URL=http://odoo:8069
ODOO_DB=robobo
ODOO_USERNAME=admin
ODOO_PASSWORD=CHANGE_ME

# Receevi (Chatwoot) - https://oc.linhafala.org.mz
# Get API key: Chatwoot → Settings → Applications → New Access Token
RECEEVI_URL=https://oc.linhafala.org.mz
RECEEVI_FRONTEND_URL=https://oc.linhafala.org.mz
RECEEVI_API_KEY=
RECEEVI_ACCOUNT_ID=1
RECEEVI_SMS_INBOX_ID=

# Redis (production compose uses requirepass)
REDIS_PASSWORD=redis_password

# Certbot / Traefik
CERTBOT_EMAIL=CERTBOT_EMAIL@domain.com
CERTBOT_DOMAIN=CERTBOT_DOMAIN.com
